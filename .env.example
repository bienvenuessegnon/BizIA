# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/local/bizia.json

# Gemini est optionnel : sans clé, BizIA garde son analyse et son chat locaux.
# Ne jamais committer de clé réelle. Configurez-la dans l'environnement du serveur.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENRICH_ANALYSIS=true

# Seuil d'alerte stock (peut être surchargé par produit)
DEFAULT_LOW_STOCK_THRESHOLD=5
