# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/local/bizia.json

# LLM optionnel (MVP : le chatbot s'appuie d'abord sur l'analyse calculée)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Seuil d'alerte stock (peut être surchargé par produit)
DEFAULT_LOW_STOCK_THRESHOLD=5
